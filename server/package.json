{
  "name": "job-board-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.js",
    "start": "node --env-file=.env src/index.js",
    "cloudinary:check": "node --env-file=.env scripts/check-cloudinary.js",
    "upload:sample": "node --env-file=.env scripts/upload-sample.js",
